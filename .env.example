DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=ml_evaluator
POSTGRES_USER=ml_evaluator
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# M3 asynchronous evaluation and sandbox (see docs/EVALUATION_ENGINE.md)
SANDBOX_IMAGE=ml-evaluator-sandbox:1.0
# Host directory for per-job inputs; created by you, owned by UID 10002, mode 0711.
SANDBOX_HOST_WORK_DIR=/var/lib/ml-evaluator/jobs
SANDBOX_INSPECTION_ENABLED=1
EVALUATION_TIMEOUT_SECONDS=120
WORKER_CONCURRENCY=3
