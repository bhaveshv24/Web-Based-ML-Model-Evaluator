DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=ml_evaluator
POSTGRES_USER=ml_evaluator
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# M3 asynchronous evaluation and sandbox (see docs/EVALUATION_ENGINE.md)
SANDBOX_IMAGE=ml-evaluator-sandbox:1.0
# Absolute host path for per-job inputs. PWD expands on macOS/Linux; on Windows set an
# absolute Docker Desktop shared path here before starting Compose.
SANDBOX_HOST_WORK_DIR=${PWD}/sandbox-jobs
SANDBOX_INSPECTION_ENABLED=1
EVALUATION_TIMEOUT_SECONDS=120
WORKER_CONCURRENCY=3
